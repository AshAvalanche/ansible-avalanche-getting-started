%{ for validator in validators ~}
${ validator.name } ansible_host=${ validator.ipv4 } ansible_user=ansible ansible_ssh_private_key_file=./files/multipass/id_rsa
%{ endfor ~}
frontend ansible_host=${ frontend.ipv4 } ansible_user=ansible ansible_ssh_private_key_file=./files/multipass/id_rsa

[avalanche_nodes]
%{ for validator in validators ~}
${ validator.name }
%{ endfor ~}

[avalanche_nodes:children]
bootstrap_nodes
subnet_txs_host
subnet_validators
api_node

[bootstrap_nodes]
%{ if length(validators) > 0 ~}
${ validators[0].name }
%{ endif ~}

[api_node]
%{ if length(validators) > 0 ~}
${ validators[0].name }
%{ endif ~}

[subnet_txs_host]
%{ if length(validators) > 0 ~}
${ validators[0].name }
%{ endif ~}

[subnet_validators]
%{ for validator in validators ~}
${ validator.name }
%{ endfor ~}

[faucet]
frontend

[blockscout]
frontend

[prometheus]
frontend

[grafana]
frontend

[erpc]
frontend

[graph_node]
frontend
